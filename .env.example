# .env.example
MAX_DOWNLOAD_DURATION_SECONDS=3600
MAX_DOWNLOAD_SIZE_MB=500
DOWNLOAD_JOB_RETENTION_HOURS=24

# Optional comma-separated allowlist of hostnames the downloader will accept.
# Leave empty to allow any http(s) source (the legal/compliance warning still applies).
# Wildcard form '*.example.com' matches subdomains.
# ALLOWED_DOWNLOAD_HOSTS=upload.wikimedia.org,*.archive.org
ALLOWED_DOWNLOAD_HOSTS=
